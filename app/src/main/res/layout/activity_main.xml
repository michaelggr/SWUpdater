<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 壁纸背景层（fitCenter 完整显示横版壁纸，不裁剪） -->
    <ImageView
        android:id="@+id/iv_wallpaper_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/btn_random_wallpaper" />

    <!-- 半透明遮罩，让壁纸透出来同时保证文字可读） -->
    <View
        android:id="@+id/view_wallpaper_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wallpaper_overlay"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary"
            app:menu="@menu/main_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- 游戏信息卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_game_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SWUpdater.CardView"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <!-- 游戏图标 + 名称 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_md">

                            <!-- 圆角图标 -->
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_game_icon"
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:src="@mipmap/ic_launcher"
                                app:shapeAppearanceOverlay="@style/RoundedIconShape"
                                android:contentDescription="@string/app_name" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="魔灵召唤：天空之役"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/text_title"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- 版本信息 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <!-- 当前版本 -->
                            <LinearLayout
                                android:id="@+id/layout_current_version"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_sm"
                                android:background="@drawable/bg_version_card"
                                android:layout_marginEnd="@dimen/spacing_sm">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/current_version_label"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/tv_current_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/text_headline"
                                    android:textStyle="bold"
                                    tools:text="9.1.7" />

                            </LinearLayout>

                            <!-- 最新版本 -->
                            <LinearLayout
                                android:id="@+id/layout_latest_version"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_sm"
                                android:background="@drawable/bg_version_card">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/latest_version_label"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/tv_latest_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/secondary"
                                    android:textSize="@dimen/text_headline"
                                    android:textStyle="bold"
                                    tools:text="9.1.9" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- 状态指示 -->
                        <LinearLayout
                            android:id="@+id/layout_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:padding="@dimen/spacing_xs">

                            <View
                                android:id="@+id/view_status_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot"
                                android:backgroundTint="@color/success" />

                            <TextView
                                android:id="@+id/tv_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="@string/status_up_to_date"
                                android:textColor="@color/success"
                                android:textSize="@dimen/text_body" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 操作按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_check_update"
                        style="@style/Widget.SWUpdater.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_check_update"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download"
                        style="@style/Widget.SWUpdater.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/btn_download"
                        android:visibility="gone"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_store"
                        style="@style/Widget.SWUpdater.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/dialog_btn_open_store"
                        android:visibility="gone"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_download"
                        style="@style/Widget.SWUpdater.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/btn_stop_download"
                        android:visibility="gone"
                        app:icon="@drawable/ic_stop"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_install"
                        style="@style/Widget.SWUpdater.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/btn_install"
                        android:visibility="gone"
                        app:icon="@drawable/ic_install"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_game"
                        style="@style/Widget.SWUpdater.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/btn_open_game"
                        android:visibility="gone"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />

                </LinearLayout>

                <!-- 下载进度卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SWUpdater.CardView"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tv_download_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download_progress"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progress_download"
                            style="@style/Widget.SWUpdater.ProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:max="100"
                            android:progress="0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_download_size"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption"
                                tools:text="45.2 MB / 120.5 MB" />

                            <TextView
                                android:id="@+id/tv_download_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption"
                                tools:text="2.5 MB/s" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_verify_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textColor="@color/info"
                            android:textSize="@dimen/text_caption"
                            android:visibility="gone"
                            tools:text="@string/verifying_integrity" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 更新日志卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SWUpdater.CardView"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/changelog_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/tv_changelog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body"
                            tools:text="• 修复已知问题\n• 新增魔灵\n• 性能优化" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 壁纸卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SWUpdater.CardView"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <!-- 标题行：壁纸 + 换一张按钮 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="壁纸"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_subtitle"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_random_wallpaper"
                                style="@style/Widget.SWUpdater.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="换一张"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="32dp"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                        </LinearLayout>

                        <!-- 壁纸缩略图 -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_wallpaper"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedIconShape"
                            android:contentDescription="当前壁纸" />

                        <!-- 无壁纸占位 -->
                        <TextView
                            android:id="@+id/tv_no_wallpaper"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:gravity="center"
                            android:text="暂无壁纸，点击「换一张」"
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/text_body"
                            android:background="@drawable/bg_version_card" />

                        <!-- 壁纸操作按钮行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_download_wallpaper"
                                style="@style/Widget.SWUpdater.Button.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="保存"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="36dp"
                                app:icon="@drawable/ic_wallpaper_download"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_apply_wallpaper"
                                style="@style/Widget.SWUpdater.Button.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="设壁纸"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="36dp"
                                app:icon="@drawable/ic_wallpaper_apply"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_open_folder"
                                style="@style/Widget.SWUpdater.Button.Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="目录"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="36dp"
                                app:icon="@drawable/ic_folder_open"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 配置抓取卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_capture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.SWUpdater.CardView"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="游戏配置抓取"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/tv_capture_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="需要 Root 权限 · 启动后打开游戏即可抓取配置数据"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_start_capture"
                                style="@style/Widget.SWUpdater.Button.Primary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:text="开始抓取"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="36dp"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_stop_capture"
                                style="@style/Widget.SWUpdater.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="停止抓取"
                                android:textSize="@dimen/text_caption"
                                android:minHeight="36dp"
                                android:visibility="gone"
                                app:icon="@drawable/ic_stop"
                                app:iconGravity="textStart"
                                app:iconSize="16dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_capture_last_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/text_caption"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========== 底部区域 ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_toolbox"
                            style="@style/Widget.SWUpdater.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="@string/btn_toolbox"
                            android:textSize="@dimen/text_caption"
                            app:icon="@drawable/ic_toolbox"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            android:minHeight="40dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback"
                            style="@style/Widget.SWUpdater.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/btn_feedback"
                            android:textSize="@dimen/text_caption"
                            app:icon="@drawable/ic_feedback"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            android:minHeight="40dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_design_by"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/design_by_text"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_caption"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
