<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== 主题1：魔灵风格（默认） ==================== -->
    <style name="Theme.SWUpdater.Game" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorPrimaryVariant">@color/game_primary_variant</item>
        <item name="colorOnPrimary">@color/game_on_primary</item>
        <item name="colorSecondary">@color/game_secondary</item>
        <item name="colorSecondaryVariant">@color/game_secondary_variant</item>
        <item name="colorOnSecondary">@color/game_on_secondary</item>
        <item name="android:colorBackground">@color/game_background</item>
        <item name="colorSurface">@color/game_surface</item>
        <item name="colorOnSurface">@color/game_on_surface</item>
        <item name="android:statusBarColor">@color/game_status_bar</item>
        <item name="android:navigationBarColor">@color/game_background</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="alertDialogTheme">@style/Theme.SWUpdater.Game.Dialog</item>
    </style>

    <style name="Theme.SWUpdater.Game.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/game_surface</item>
        <item name="colorOnSurface">@color/game_on_surface</item>
        <item name="colorPrimary">@color/game_secondary</item>
        <item name="colorOnPrimary">@color/game_on_secondary</item>
    </style>

    <!-- ==================== 主题2：简洁风格 ==================== -->
    <style name="Theme.SWUpdater.Simple" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/simple_primary</item>
        <item name="colorPrimaryVariant">@color/simple_primary_variant</item>
        <item name="colorOnPrimary">@color/simple_on_primary</item>
        <item name="colorSecondary">@color/simple_secondary</item>
        <item name="colorSecondaryVariant">@color/simple_secondary_variant</item>
        <item name="colorOnSecondary">@color/simple_on_secondary</item>
        <item name="android:colorBackground">@color/simple_background</item>
        <item name="colorSurface">@color/simple_surface</item>
        <item name="colorOnSurface">@color/simple_on_surface</item>
        <item name="android:statusBarColor">@color/simple_status_bar</item>
        <item name="android:navigationBarColor">@color/simple_background</item>
        <item name="android:windowBackground">@color/simple_background</item>
        <item name="alertDialogTheme">@style/Theme.SWUpdater.Simple.Dialog</item>
    </style>

    <style name="Theme.SWUpdater.Simple.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/simple_surface</item>
        <item name="colorOnSurface">@color/simple_on_surface</item>
        <item name="colorPrimary">@color/simple_secondary</item>
        <item name="colorOnPrimary">@color/simple_on_secondary</item>
    </style>

    <!-- ==================== 主题3：暗夜风格（OLED） ==================== -->
    <style name="Theme.SWUpdater.Night" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/night_primary</item>
        <item name="colorPrimaryVariant">@color/night_primary_variant</item>
        <item name="colorOnPrimary">@color/night_on_primary</item>
        <item name="colorSecondary">@color/night_secondary</item>
        <item name="colorSecondaryVariant">@color/night_secondary_variant</item>
        <item name="colorOnSecondary">@color/night_on_secondary</item>
        <item name="android:colorBackground">@color/night_background</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="colorOnSurface">@color/night_on_surface</item>
        <item name="android:statusBarColor">@color/night_status_bar</item>
        <item name="android:navigationBarColor">@color/night_background</item>
        <item name="android:windowBackground">@color/night_background</item>
        <item name="alertDialogTheme">@style/Theme.SWUpdater.Night.Dialog</item>
    </style>

    <style name="Theme.SWUpdater.Night.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/night_surface</item>
        <item name="colorOnSurface">@color/night_on_surface</item>
        <item name="colorPrimary">@color/night_secondary</item>
        <item name="colorOnPrimary">@color/night_on_secondary</item>
    </style>

    <!-- ==================== 主题4：樱花风格 ==================== -->
    <style name="Theme.SWUpdater.Sakura" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/sakura_primary</item>
        <item name="colorPrimaryVariant">@color/sakura_primary_variant</item>
        <item name="colorOnPrimary">@color/sakura_on_primary</item>
        <item name="colorSecondary">@color/sakura_secondary</item>
        <item name="colorSecondaryVariant">@color/sakura_secondary_variant</item>
        <item name="colorOnSecondary">@color/sakura_on_secondary</item>
        <item name="android:colorBackground">@color/sakura_background</item>
        <item name="colorSurface">@color/sakura_surface</item>
        <item name="colorOnSurface">@color/sakura_on_surface</item>
        <item name="android:statusBarColor">@color/sakura_status_bar</item>
        <item name="android:navigationBarColor">@color/sakura_background</item>
        <item name="android:windowBackground">@color/sakura_background</item>
        <item name="alertDialogTheme">@style/Theme.SWUpdater.Sakura.Dialog</item>
    </style>

    <style name="Theme.SWUpdater.Sakura.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/sakura_surface</item>
        <item name="colorOnSurface">@color/sakura_on_surface</item>
        <item name="colorPrimary">@color/sakura_secondary</item>
        <item name="colorOnPrimary">@color/sakura_on_secondary</item>
    </style>

    <!-- ==================== 默认主题别名（指向魔灵风格） ==================== -->
    <style name="Theme.SWUpdater" parent="Theme.SWUpdater.Game" />

    <!-- ==================== 通用组件样式 ==================== -->
    <style name="Widget.SWUpdater.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogNegative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogNeutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <style name="Widget.SWUpdater.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.SWUpdater.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SWUpdater.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.SWUpdater.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SWUpdater.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressBackgroundTint">@color/surface_variant</item>
        <item name="android:progressTint">?attr/colorSecondary</item>
        <item name="android:minHeight">@dimen/progress_height</item>
        <item name="android:maxHeight">@dimen/progress_height</item>
    </style>

    <style name="RoundedIconShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.SWUpdater.Button.Tonal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">?attr/colorSecondaryVariant</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>