<?xml version="1.0" encoding="utf-8"?>
<!-- 魔灵召唤风格统一暗色主题 -->
<resources>
    <style name="Theme.SWUpdater" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="alertDialogTheme">@style/Theme.SWUpdater.Dialog</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 统一弹窗风格 -->
    <style name="Theme.SWUpdater.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorOnPrimary">@color/on_secondary</item>
        <item name="android:windowTitleStyle">@style/Widget.SWUpdater.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SWUpdater.Button.DialogPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SWUpdater.Button.DialogNegative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.SWUpdater.Button.DialogNeutral</item>
    </style>

    <style name="Widget.SWUpdater.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondary</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogNegative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.SWUpdater.Button.DialogNeutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- 卡片：金色边框 -->
    <style name="Widget.SWUpdater.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_gold</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <!-- 主按钮：金色 -->
    <style name="Widget.SWUpdater.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/on_secondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 描边按钮 -->
    <style name="Widget.SWUpdater.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/secondary</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Widget.SWUpdater.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/secondary</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 进度条：金色 -->
    <style name="Widget.SWUpdater.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressBackgroundTint">@color/progress_background</item>
        <item name="android:progressTint">@color/progress_foreground</item>
        <item name="android:minHeight">@dimen/progress_height</item>
        <item name="android:maxHeight">@dimen/progress_height</item>
    </style>

    <!-- 圆角图标形状 -->
    <style name="RoundedIconShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Tonal 按钮 -->
    <style name="Widget.SWUpdater.Button.Tonal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/secondary_container</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="cornerRadius">@dimen/corner_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
